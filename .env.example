# ============================================================
#  VAYUKAVACH-360 — Environment Variables Template
#  Copy this file to '.env' locally or set these variables in
#  your cloud deployment platform (Render, Railway, Vercel, etc.)
# ============================================================

# ------------------------------------------------------------
# 1. Google Gemini AI Key
#    Required for Gemini 2.0 Flash / Pro Structural Reasoning
#    Get key at: https://aistudio.google.com/
# ------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------
# 2. Backend Server Settings (FastAPI)
# ------------------------------------------------------------
PORT=8000
HOST=0.0.0.0

# ------------------------------------------------------------
# 3. Frontend Next.js API URL
#    Local development: http://localhost:8000
#    Production: Set to your deployed FastAPI backend URL
# ------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
